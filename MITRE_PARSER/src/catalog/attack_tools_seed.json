[
  {
    "id": "TOOL-SEED-001",
    "name": "Hydra (THC-Hydra)",
    "type": "exploitation",
    "description": "Параллельный сетевой подборщик паролей с поддержкой множества протоколов: SSH, RDP, FTP, HTTP(S), SMB, MySQL, PostgreSQL, VNC, IMAP, POP3 и других.",
    "url": "https://github.com/vanhauser-thc/thc-hydra",
    "applicable_attack_types": ["brute_force", "password_guessing", "credential_access"],
    "applicable_cve": [],
    "commands": {
      "default": [
        "# Перебор пароля SSH по словарю",
        "hydra -l <USER> -P /usr/share/wordlists/rockyou.txt ssh://<TARGET_IP>",
        "",
        "# Перебор пользователей и паролей RDP",
        "hydra -L users.txt -P passwords.txt rdp://<TARGET_IP>",
        "",
        "# Подбор HTTP basic auth",
        "hydra -l admin -P passwords.txt <TARGET_IP> http-get /admin/",
        "",
        "# Подбор формы входа (POST)",
        "hydra -l admin -P passwords.txt <TARGET_IP> http-post-form '/login.php:user=^USER^&pass=^PASS^:F=Invalid'"
      ]
    },
    "phases": ["Получение учётных данных", "Эксплуатация"],
    "skill_level": "Beginner",
    "os": ["Linux", "Windows", "macOS"]
  },
  {
    "id": "TOOL-SEED-002",
    "name": "John the Ripper",
    "type": "credential_cracking",
    "description": "Локальный парольный взломщик хешей (NTLM, MD5, bcrypt, SHA-*, Kerberos AS-REP/TGS, ZIP/PDF, ОС-теневые файлы).",
    "url": "https://www.openwall.com/john/",
    "applicable_attack_types": ["credential_access", "credential_cracking"],
    "applicable_cve": [],
    "commands": {
      "default": [
        "# Подготовка теневого файла Linux",
        "unshadow /etc/passwd /etc/shadow > unshadowed.txt",
        "john --wordlist=/usr/share/wordlists/rockyou.txt unshadowed.txt",
        "john --show unshadowed.txt",
        "",
        "# Взлом NTLM-хешей",
        "john --format=NT --wordlist=rockyou.txt hashes.txt",
        "",
        "# Взлом Kerberos AS-REP roast",
        "john --wordlist=rockyou.txt asrep_hashes.txt"
      ]
    },
    "phases": ["Получение учётных данных", "Пост-эксплуатация"],
    "skill_level": "Intermediate",
    "os": ["Linux", "Windows", "macOS"]
  },
